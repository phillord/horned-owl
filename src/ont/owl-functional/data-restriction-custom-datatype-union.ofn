Prefix(:=<http://www.example.com/iri#>)
Prefix(o:=<http://www.example.com/iri#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://www.example.com/iri>
<http://www.example.com/viri>

Declaration(Class(o:A))
Declaration(Class(o:B))
Declaration(Class(o:C))
Declaration(DataProperty(o:load))
Declaration(Datatype(o:Percentage))


############################
#   Classes
############################

# Class: <http://www.example.com/iri#A> (<http://www.example.com/iri#A>)

SubClassOf(o:A DataAllValuesFrom(o:load DataUnionOf(o:Percentage DataOneOf("10"^^xsd:integer "20"^^xsd:integer))))

# Class: <http://www.example.com/iri#B> (<http://www.example.com/iri#B>)

SubClassOf(o:B DataSomeValuesFrom(o:load DataIntersectionOf(o:Percentage xsd:decimal)))

# Class: <http://www.example.com/iri#C> (<http://www.example.com/iri#C>)

SubClassOf(o:C DataAllValuesFrom(o:load DataUnionOf(o:Percentage DataComplementOf(xsd:decimal))))


)