@prefix : <http://www.example.com/iri#> .
@prefix o: <http://www.example.com/iri#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.com/iri#> .

<http://www.example.com/iri> rdf:type owl:Ontology ;
                              owl:versionIRI <http://www.example.com/viri> .

#################################################################
#    Datatypes
#################################################################

###  http://www.example.com/iri#Percentage
o:Percentage rdf:type rdfs:Datatype .


#################################################################
#    Data properties
#################################################################

###  http://www.example.com/iri#load
o:load rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://www.example.com/iri#A
o:A rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty o:load ;
                      owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                          owl:unionOf ( o:Percentage
                                                        [ rdf:type rdfs:Datatype ;
                                                          owl:oneOf [ rdf:type rdf:List ;
                                                                      rdf:first 10 ;
                                                                      rdf:rest [ rdf:type rdf:List ;
                                                                                 rdf:first 20 ;
                                                                                 rdf:rest rdf:nil
                                                                               ]
                                                                    ]
                                                        ]
                                                      )
                                        ]
                    ] .


###  http://www.example.com/iri#B
o:B rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty o:load ;
                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                           owl:intersectionOf ( o:Percentage
                                                                xsd:decimal
                                                              )
                                         ]
                    ] .


###  http://www.example.com/iri#C
o:C rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                      owl:onProperty o:load ;
                      owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                          owl:unionOf ( o:Percentage
                                                        [ rdf:type rdfs:Datatype ;
                                                          owl:datatypeComplementOf xsd:decimal
                                                        ]
                                                      )
                                        ]
                    ] .


