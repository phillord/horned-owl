Prefix(:=<http://www.example.com/iri#>)
Prefix(o:=<http://www.example.com/iri#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://www.example.com/iri>
Annotation(<http://opencaesar.io/oml#namespace> <http://www.example.com/iri#>)
Annotation(<http://opencaesar.io/oml#prefix> "o")
Annotation(<http://opencaesar.io/oml#type> <http://opencaesar.io/oml#Vocabulary>)

Declaration(ObjectProperty(o:r))
Declaration(ObjectProperty(o:s))
Declaration(AnnotationProperty(<http://opencaesar.io/oml#namespace>))
Declaration(AnnotationProperty(<http://opencaesar.io/oml#prefix>))
Declaration(AnnotationProperty(<http://opencaesar.io/oml#type>))

############################
#   Object Properties
############################

# Object Property: <http://www.example.com/iri#r> (<http://www.example.com/iri#r>)

AnnotationAssertion(<http://opencaesar.io/oml#type> o:r <http://opencaesar.io/oml#UnreifiedRelation>)
EquivalentObjectProperties(o:r o:s)

# Object Property: <http://www.example.com/iri#s> (<http://www.example.com/iri#s>)

AnnotationAssertion(<http://opencaesar.io/oml#type> o:s <http://opencaesar.io/oml#UnreifiedRelation>)



