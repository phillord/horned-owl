# Copy this file to `.env` and fill in your real key:
#   cp .env.example .env
#
# `.env` is gitignored so your key is never committed. Note the tool does NOT
# read `.env` automatically -- load it into your shell before running fetch:
#   set -a; source .env; set +a
#   horned-roundtrip fetch --out ./corpus
#
# Alternatively, skip .env entirely and pass --api-key on the command line.

# BioPortal REST API key. Get one at https://bioportal.bioontology.org/account
# Used by `horned-roundtrip fetch` as the `apikey` query param on every request.
BIOPORTAL_API_KEY=your-key-here
